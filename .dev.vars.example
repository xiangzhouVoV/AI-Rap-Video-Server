# Browser-visible frontend origin; local Next.js proxies authentication and template APIs.
BETTER_AUTH_URL=http://localhost:3000
# Generate locally: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Web application authorized redirect URI:
# http://localhost:3000/api/auth/callback/google

# SeeAPI credentials are server-only. Keep real keys in .dev.vars / Workers Secrets.
SEEAPI_API_BASE_URL=https://api.seeapi.com
SEEAPI_API_KEY=

# Optional public HTTPS origin that reaches THIS Worker's media routes and storage.
# Localhost uploads can be previewed, but SeeAPI cannot read them without this origin.
# For local generation without a tunnel, use direct HTTPS media URLs in the template lab.
MEDIA_PUBLIC_BASE_URL=
# Required outside localhost: comma-separated Google account emails allowed to spend provider credits.
TEMPLATE_DEBUG_EMAILS=
# Optional default reference MP4/MOV URL (2–15s, 480p/720p, 24–60fps).
# Use a direct HTTPS file URL under your control, not a TikTok webpage.
TEMPLATE_REFERENCE_VIDEO_URL=
